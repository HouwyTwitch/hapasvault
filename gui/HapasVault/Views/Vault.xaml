<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:HapasVault.Controls"
                    xmlns:vm="clr-namespace:HapasVault.ViewModels">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../Themes/Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ===================== оболочка: навигация + панель ===================== -->
  <DataTemplate DataType="{x:Type vm:VaultShellViewModel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="0,4,0,16">
        <Button DockPanel.Dock="Top" Style="{StaticResource Fab}" c:A.Icon="{StaticResource Icon.Add}" HorizontalAlignment="Center"
                Margin="0,0,0,32" Command="{Binding NewEntryCommand}" ToolTip="Новая запись (Ctrl+N)" />
        <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton.Tonal}" Width="56" Height="56" HorizontalAlignment="Center"
                c:A.Icon="{StaticResource Icon.Lock}" Command="{Binding Shell.LockCommand}" ToolTip="Заблокировать (Ctrl+L)" />
        <StackPanel>
          <RadioButton Style="{StaticResource NavItem}" Content="Хранилище" c:A.Icon="{StaticResource Icon.Key}" c:A.IconSelected="{StaticResource Icon.KeyFill}"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Vault}" />
          <RadioButton Style="{StaticResource NavItem}" Content="Журнал" c:A.Icon="{StaticResource Icon.History}" c:A.IconSelected="{StaticResource Icon.HistoryFill}"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Log}" />
          <RadioButton Style="{StaticResource NavItem}" Content="Настройки" c:A.Icon="{StaticResource Icon.Settings}" c:A.IconSelected="{StaticResource Icon.SettingsFill}"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
        </StackPanel>
      </DockPanel>
      <Border Grid.Column="1" Margin="0,0,12,12" CornerRadius="28" Background="{DynamicResource SurfaceContainerLow}">
        <c:TransitionPresenter Content="{Binding Current}" Kind="Scale" />
      </Border>
    </Grid>
  </DataTemplate>

  <!-- ===================== список записей ===================== -->
  <DataTemplate x:Key="EntryRow" DataType="{x:Type vm:EntryViewModel}">
    <RadioButton Style="{StaticResource ListRow}" IsChecked="{Binding IsSelected}" c:A.Position="{Binding Position}">
      <DockPanel>
        <c:MorphShape DockPanel.Dock="Left" Width="44" Height="44" Shape="{Binding Shape}" TargetShape="Circle" HoverMorph="True"
                      Fill="{Binding FillKey, Converter={StaticResource Resource}}">
          <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding OnFillKey, Converter={StaticResource Resource}}" />
        </c:MorphShape>
        <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.ArrowForward}" Width="20" Height="20" Opacity="0.6" />
        <StackPanel VerticalAlignment="Center" Margin="16,0">
          <TextBlock Style="{StaticResource Title.Medium}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Style="{StaticResource Body.Medium}" Text="{Binding CategoryOrDefault}" Opacity="0.72" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
      </DockPanel>
    </RadioButton>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:VaultViewModel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Margin="32,24,24,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,4,6" Style="{StaticResource Body.Large}"
                     Foreground="{DynamicResource OnSurfaceVariant}" Text="{Binding CountText}" />
          <TextBlock Style="{StaticResource Display.Emphasized}" FontSize="40" LineHeight="48" Text="Хранилище" />
        </DockPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource SearchField}"
                 c:A.Placeholder="Поиск по названию и категории  (Ctrl+F)" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
        <ItemsControl Grid.Row="2" Margin="0,16,0,4" ItemsSource="{Binding Categories}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource Chip}" Margin="0,0,8,8" IsChecked="{Binding IsSelected}" GroupName="categories">
                <TextBlock>
                  <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource OnSurfaceVariant}" />
                </TextBlock>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
          <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,12,0,4" c:A.Enter="0">
                  <TextBlock Style="{StaticResource Label.Large}" Margin="20,0,0,8" Foreground="{DynamicResource Primary}" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource EntryRow}" Focusable="False" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- пусто -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
          <c:MorphShape Width="140" Height="140" Shape="Flower" TargetShape="Cookie12" Spin="10" Fill="{DynamicResource SecondaryContainer}">
            <c:Icon Data="{StaticResource Icon.KeyVertical}" Width="56" Height="56" Foreground="{DynamicResource OnSecondaryContainer}" />
          </c:MorphShape>
          <TextBlock Style="{StaticResource Headline.Small}" TextAlignment="Center" Margin="0,24,0,8" Text="Здесь пока пусто" />
          <TextBlock Style="{StaticResource Body.Medium}" TextAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}"
                     Text="Добавьте первую запись — пароль сразу уйдёт на токен." />
          <Button Style="{StaticResource Fab.Extended}" Margin="0,24,0,0" HorizontalAlignment="Center" Content="Новая запись"
                  c:A.Icon="{StaticResource Icon.Add}" Command="{Binding AddCommand}" />
        </StackPanel>
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding NothingFound, Converter={StaticResource VisibleWhen}}">
          <c:MorphShape Width="96" Height="96" Shape="Clover4" Fill="{DynamicResource SurfaceContainerHighest}">
            <c:Icon Data="{StaticResource Icon.Search}" Width="40" Height="40" Foreground="{DynamicResource OnSurfaceVariant}" />
          </c:MorphShape>
          <TextBlock Style="{StaticResource Title.Large}" TextAlignment="Center" Margin="0,20,0,0" Text="Ничего не найдено" />
        </StackPanel>
        <c:LoadingIndicator Grid.Row="3" Foreground="{DynamicResource Primary}" VerticalAlignment="Top" Margin="0,40,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
      </Grid>

      <!-- детали -->
      <Border Grid.Column="1" Width="380" Margin="0,12,12,12" CornerRadius="24" Background="{DynamicResource SurfaceContainer}"
              Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}">
        <c:TransitionPresenter Content="{Binding Detail}" Kind="SlideLeft" />
      </Border>
    </Grid>
  </DataTemplate>

  <!-- поле в карточке деталей -->
  <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Mono.Large}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <DataTemplate DataType="{x:Type vm:DetailViewModel}">
    <DockPanel Margin="20,16,20,20">
      <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Style="{StaticResource IconButton}" c:A.Icon="{StaticResource Icon.Close}"
              Command="{Binding CloseCommand}" ToolTip="Закрыть (Esc)" />
      <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,16,0,0">
        <Button Style="{StaticResource Button.Tonal}" Margin="0,0,6,0" MinHeight="48" Content="Изменить" c:A.Icon="{StaticResource Icon.Edit}" Command="{Binding EditCommand}" />
        <Button Style="{StaticResource Button.DangerTonal}" Margin="6,0,0,0" MinHeight="48" Content="Удалить" c:A.Icon="{StaticResource Icon.Delete}" Command="{Binding DeleteCommand}" />
      </UniformGrid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <c:MorphShape Width="120" Height="120" Shape="{Binding Entry.Shape}" TargetShape="Sunny" HoverMorph="True"
                        Fill="{Binding Entry.FillKey, Converter={StaticResource Resource}}">
            <TextBlock Text="{Binding Entry.Initial}" FontSize="48" FontWeight="SemiBold" Foreground="{Binding Entry.OnFillKey, Converter={StaticResource Resource}}" />
          </c:MorphShape>
          <TextBlock Style="{StaticResource Headline.Small}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,8" Text="{Binding Entry.Name}" />
          <Border HorizontalAlignment="Center" CornerRadius="10" Padding="12,4" Background="{DynamicResource SecondaryContainer}">
            <TextBlock Style="{StaticResource Label.Large}" Foreground="{DynamicResource OnSecondaryContainer}" Text="{Binding Entry.CategoryOrDefault}" />
          </Border>

          <Border Margin="0,24,0,0" CornerRadius="24" Background="{DynamicResource SurfaceContainerHighest}" Padding="20,8,8,8">
            <StackPanel>
              <DockPanel Height="64">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:A.Icon="{StaticResource Icon.ContentCopy}" Command="{Binding CopyLoginCommand}" ToolTip="Копировать логин" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Body.Small}" Foreground="{DynamicResource OnSurfaceVariant}" Text="Логин" />
                  <TextBlock Style="{StaticResource DetailValue}" Text="{Binding LoginText}" />
                </StackPanel>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource OutlineVariant}" Margin="0,0,12,0" />
              <DockPanel Height="64">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:A.Icon="{StaticResource Icon.ContentCopy}" Command="{Binding CopyPasswordCommand}" ToolTip="Копировать пароль" />
                <Button DockPanel.Dock="Right" Command="{Binding RevealCommand}" ToolTip="Показать или скрыть пароль">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="c:A.Icon" Value="{StaticResource Icon.Visibility}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                          <Setter Property="c:A.Icon" Value="{StaticResource Icon.VisibilityOff}" />
                          <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
                          <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Body.Small}" Foreground="{DynamicResource OnSurfaceVariant}" Text="Пароль" />
                  <TextBlock Style="{StaticResource DetailValue}" Text="{Binding PasswordText}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
          <c:WavyProgress Margin="12,12,12,0" IsIndeterminate="True" Foreground="{DynamicResource Primary}" Track="{DynamicResource SecondaryContainer}"
                          Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
          <DockPanel Margin="4,16,4,0">
            <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.ShieldLock}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top"
                    Foreground="{DynamicResource OnSurfaceVariant}" />
            <TextBlock Style="{StaticResource Body.Small}" Foreground="{DynamicResource OnSurfaceVariant}"
                       Text="Логин и пароль расшифровываются на токене по запросу и стираются из памяти через 30 секунд." />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- ===================== журнал ===================== -->
  <DataTemplate DataType="{x:Type vm:LogViewModel}">
    <Grid Margin="32,24,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton.Tonal}" c:A.Icon="{StaticResource Icon.Refresh}" Command="{Binding LoadCommand}"
                ToolTip="Обновить" VerticalAlignment="Bottom" />
        <StackPanel>
          <TextBlock Style="{StaticResource Display.Emphasized}" FontSize="40" LineHeight="48" Text="Журнал" />
          <TextBlock Style="{StaticResource Body.Large}" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,4,0,0" Text="{Binding Summary}" />
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" CornerRadius="20" Padding="18,14" Margin="0,20,0,12" Background="{DynamicResource SecondaryContainer}">
        <DockPanel>
          <c:Icon Data="{StaticResource Icon.Info}" Foreground="{DynamicResource OnSecondaryContainer}" Margin="0,0,12,0" />
          <TextBlock Style="{StaticResource Body.Medium}" Foreground="{DynamicResource OnSecondaryContainer}" VerticalAlignment="Center"
                     Text="Токен помнит последние 32 операции с момента подключения. Время указано по часам токена." />
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="20" Padding="12,10,20,10" Margin="0,0,0,4" Background="{DynamicResource SurfaceContainer}" c:A.Enter="0">
                <DockPanel>
                  <c:MorphShape DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0">
                    <c:MorphShape.Style>
                      <Style TargetType="c:MorphShape">
                        <Setter Property="Shape" Value="Cookie6" />
                        <Setter Property="Fill" Value="{DynamicResource SecondaryContainer}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Ok}" Value="False">
                            <Setter Property="Shape" Value="Burst" />
                            <Setter Property="Fill" Value="{DynamicResource ErrorContainer}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnErrorContainer}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </c:MorphShape.Style>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource Resource}}" Width="20" Height="20" />
                  </c:MorphShape>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label.Large}" Foreground="{DynamicResource Error}" VerticalAlignment="Center"
                             Text="{Binding StatusText}" MaxWidth="280" TextAlignment="Right" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Title.Medium}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Body.Medium}" Foreground="{DynamicResource OnSurfaceVariant}" Text="{Binding Subtitle}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <c:LoadingIndicator Grid.Row="2" VerticalAlignment="Top" Margin="0,40,0,0" Foreground="{DynamicResource Primary}"
                          Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
    </Grid>
  </DataTemplate>

  <!-- ===================== настройки ===================== -->
  <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource Title.Medium}" />
  <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource Body.Medium}">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Margin" Value="0,2,24,0" />
  </Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Title.Small}">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="Margin" Value="20,32,0,10" />
  </Style>
  <Style x:Key="SettingRow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainer}" />
    <Setter Property="Padding" Value="24,18" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,24,32,40">
        <TextBlock Style="{StaticResource Display.Emphasized}" FontSize="40" LineHeight="48" Text="Настройки" />

        <!-- оформление -->
        <TextBlock Style="{StaticResource Section}" Text="Оформление" />
        <Border Style="{StaticResource SettingRow}" CornerRadius="28,28,6,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Style="{StaticResource Connected}" c:A.Position="First" Content="Системная" c:A.Icon="{StaticResource Icon.Contrast}"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Middle" Content="Светлая" c:A.Icon="{StaticResource Icon.LightMode}"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Last" Content="Тёмная" c:A.Icon="{StaticResource Icon.DarkMode}" Margin="0"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Тема" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Системная следует за Windows" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Style="{StaticResource Connected}" c:A.Position="First" Content="Спокойная"
                           IsChecked="{Binding Palette, Converter={StaticResource Equals}, ConverterParameter=TonalSpot}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Middle" Content="Яркая"
                           IsChecked="{Binding Palette, Converter={StaticResource Equals}, ConverterParameter=Vibrant}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Last" Content="Экспрессивная" Margin="0"
                           IsChecked="{Binding Palette, Converter={StaticResource Equals}, ConverterParameter=Expressive}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Палитра" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Насколько смело раскрашивать интерфейс" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}" CornerRadius="6,6,28,28">
          <StackPanel>
            <TextBlock Style="{StaticResource SettingTitle}" Text="Цвет" />
            <TextBlock Style="{StaticResource SettingHint}" Text="Тональная палитра Material 3 строится из выбранного цвета" />
            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,16,0,0" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,12,8" Cursor="Hand" ToolTip="{Binding Name}" FocusVisualStyle="{StaticResource FocusRing}"
                          Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <StackPanel Width="64">
                          <c:MorphShape Width="52" Height="52" Shape="Circle" TargetShape="Cookie9" IsMorphed="{Binding IsSelected}"
                                        HoverMorph="True" Fill="{Binding Brush}">
                            <Grid>
                              <c:Icon Data="{StaticResource Icon.Check}" Foreground="White" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}" />
                              <c:Icon Data="{StaticResource Icon.Palette}" Foreground="White" Width="20" Height="20">
                                <c:Icon.Style>
                                  <Style TargetType="c:Icon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                          <Condition Binding="{Binding IsAccent}" Value="True" />
                                          <Condition Binding="{Binding IsSelected}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                      </MultiDataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </c:Icon.Style>
                              </c:Icon>
                            </Grid>
                          </c:MorphShape>
                          <TextBlock Style="{StaticResource Label.Small}" TextAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource OnSurfaceVariant}"
                                     Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- радиальное меню -->
        <TextBlock Style="{StaticResource Section}" Text="Радиальное меню" />
        <Border Style="{StaticResource SettingRow}" CornerRadius="28,28,6,6">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RadialEnabled}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Вызов в любом приложении" />
              <TextBlock Style="{StaticResource SettingHint}"
                         Text="Меню появляется под курсором; запись выбирается движением мыши, набор текста — поиск. Выбранная запись вводится в окно, где вы были." />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <DockPanel IsEnabled="{Binding RadialEnabled}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Style="{StaticResource Connected}" c:A.Position="First" Content="Ctrl+Alt+Space"
                           IsChecked="{Binding Hotkey, Converter={StaticResource Equals}, ConverterParameter=CtrlAltSpace}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Middle" Content="Ctrl+Shift+Space"
                           IsChecked="{Binding Hotkey, Converter={StaticResource Equals}, ConverterParameter=CtrlShiftSpace}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Last" Content="Ctrl+Alt+P" Margin="0"
                           IsChecked="{Binding Hotkey, Converter={StaticResource Equals}, ConverterParameter=CtrlAltP}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Сочетание клавиш" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Работает, пока HapasVault запущен (можно свернуть)" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}" CornerRadius="6,6,28,28">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoTypeEnter}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Нажимать Enter после ввода" />
              <TextBlock Style="{StaticResource SettingHint}" Text="ЛКМ — логин ⇥ пароль, ПКМ — только пароль, Shift+ЛКМ — только логин" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- безопасность -->
        <TextBlock Style="{StaticResource Section}" Text="Безопасность" />
        <Border Style="{StaticResource SettingRow}" CornerRadius="28,28,6,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton Style="{StaticResource Connected}" c:A.Position="First" Content="1 мин"
                           IsChecked="{Binding AutoLock, Converter={StaticResource Equals}, ConverterParameter=1}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Middle" Content="5 мин"
                           IsChecked="{Binding AutoLock, Converter={StaticResource Equals}, ConverterParameter=5}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Middle" Content="15 мин"
                           IsChecked="{Binding AutoLock, Converter={StaticResource Equals}, ConverterParameter=15}" />
              <RadioButton Style="{StaticResource Connected}" c:A.Position="Last" Content="Никогда" Margin="0"
                           IsChecked="{Binding AutoLock, Converter={StaticResource Equals}, ConverterParameter=0}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Автоблокировка" />
              <TextBlock Style="{StaticResource SettingHint}" Text="При бездействии в приложении. Токен сам закрывается через 5 минут простоя." />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LockWithWindows}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Блокировать вместе с Windows" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Win+L, смена пользователя, переход в сон" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}" CornerRadius="6,6,28,28">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ClearClipboard}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Очищать буфер обмена через 30 с" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Скопированные пароли не попадают в журнал Win+V и облачный буфер" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- токен -->
        <TextBlock Style="{StaticResource Section}" Text="Токен" />
        <Border Style="{StaticResource SettingRow}" CornerRadius="28,28,6,6">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Tonal}" Content="Сохранить копию" c:A.Icon="{StaticResource Icon.Download}"
                    VerticalAlignment="Center" Command="{Binding BackupCommand}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Резервная копия" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Зашифрованный файл хранилища. Без 24 слов и мастер-пароля его не открыть." />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <TextBox Style="{StaticResource TextField.Mono}" Width="140" c:A.Label="Порт" c:A.Error="{Binding PortError}"
                       Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
              <Button Style="{StaticResource Button.Outlined}" Margin="12,8,0,0" VerticalAlignment="Top" Content="Применить" Command="{Binding ApplyPortCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="Подключение" />
              <TextBlock Style="{StaticResource SettingHint}" Text="{Binding TokenText}" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Симулятор слушает только 127.0.0.1" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}" CornerRadius="6,6,28,28">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Content="Стереть токен" c:A.Icon="{StaticResource Icon.Delete}"
                    VerticalAlignment="Center" Command="{Binding FactoryResetCommand}" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Foreground="{DynamicResource Error}" Text="Сброс к заводским настройкам" />
              <TextBlock Style="{StaticResource SettingHint}" Text="Удаляет записи, ключи и сопряжение. Отменить нельзя." />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Background="{DynamicResource TertiaryContainer}"
                Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Filled}" Content="Выйти из демо" Command="{Binding ExitDemoCommand}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Body.Large}" Foreground="{DynamicResource OnTertiaryContainer}" VerticalAlignment="Center"
                       Text="Сейчас открыт демо-режим: данные живут только в памяти." />
          </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="20,32,0,0">
          <c:MorphShape Width="28" Height="28" Shape="Cookie9" Fill="{DynamicResource Primary}" Spin="20">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource OnPrimary}" />
          </c:MorphShape>
          <TextBlock Style="{StaticResource Body.Medium}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}">
            <Run Text="HapasVault" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
            <Run Text=" · Material 3 Expressive · шрифт Roboto, иконки Material Symbols" />
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
