<Window x:Class="HapasVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HapasVault.Controls"
        xmlns:vm="clr-namespace:HapasVault.ViewModels"
        Title="HapasVault" Width="1220" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource OnSurface}"
        FontFamily="{StaticResource Font.Sans}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Icon="pack://application:,,,/HapasVault;component/Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Caption.Close" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ErrorContainer}" />
          <Setter Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- заголовок -->
    <DockPanel Margin="18,0,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <c:WavyProgress Width="64" Margin="0,0,12,0" IsIndeterminate="True" Foreground="{DynamicResource Primary}" Track="{DynamicResource SecondaryContainer}"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
        <Button Style="{StaticResource Caption}" c:A.Icon="{StaticResource Icon.Remove}" Click="OnMinimize" ToolTip="Свернуть" />
        <Button x:Name="MaxButton" Style="{StaticResource Caption}" c:A.Icon="{StaticResource Icon.CropSquare}" Click="OnMaximize" ToolTip="Развернуть" />
        <Button Style="{StaticResource Caption.Close}" c:A.Icon="{StaticResource Icon.Close}" Click="OnClose" ToolTip="Закрыть" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <c:MorphShape Width="28" Height="28" Shape="Cookie9" TargetShape="Sunny" HoverMorph="True" Fill="{DynamicResource Primary}"
                      WindowChrome.IsHitTestVisibleInChrome="True">
          <c:Icon Data="{StaticResource Icon.KeyVerticalFill}" Width="16" Height="16" Foreground="{DynamicResource OnPrimary}" />
        </c:MorphShape>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="HapasVault" />
        <Border Margin="14,0,0,0" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{DynamicResource SurfaceContainerHigh}"
                Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Outline}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDemo}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Tertiary}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Style="{StaticResource Label.Medium}" Foreground="{DynamicResource OnSurfaceVariant}" Text="{Binding Status}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- экран -->
    <c:TransitionPresenter Grid.Row="1" Content="{Binding Page}" Kind="SlideUp" Focusable="False" />

    <!-- диалог -->
    <Grid Grid.RowSpan="2" Visibility="{Binding Dialog, Converter={StaticResource VisibleWhen}}">
      <Border Background="{DynamicResource Scrim}" Opacity="0.36" MouseLeftButtonDown="OnScrimClick" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="28,24" CornerRadius="28"
              Background="{DynamicResource SurfaceContainerHigh}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding ActualHeight, ElementName=Root, Converter={StaticResource Subtract}, ConverterParameter=96}">
          <c:TransitionPresenter Content="{Binding Dialog}" Kind="Scale" />
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- снэкбар -->
    <Border x:Name="Snack" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,28" MinWidth="320" MaxWidth="640"
            CornerRadius="16" Padding="20,6,8,6" Background="{DynamicResource InverseSurface}" Opacity="0">
      <Border.RenderTransform>
        <TranslateTransform x:Name="SnackMove" Y="40" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.25" Color="Black" />
      </Border.Effect>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="IsHitTestVisible" Value="False" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Snackbar.IsOpen}" Value="True">
              <Setter Property="IsHitTestVisible" Value="True" />
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.55" EasingFunction="{StaticResource Spring.Bouncy}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="40" Duration="0:0:0.25" EasingFunction="{StaticResource Ease.Emphasized}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel MinHeight="40">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="{DynamicResource InverseOnSurface}"
                c:A.Icon="{StaticResource Icon.Close}" Command="{Binding Snackbar.HideCommand}" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Text}" Foreground="{DynamicResource InversePrimary}"
                Content="{Binding Snackbar.ActionText}" Command="{Binding Snackbar.ActCommand}"
                Visibility="{Binding Snackbar.ActionText, Converter={StaticResource VisibleWhen}}" />
        <TextBlock Style="{StaticResource Body.Medium}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource InverseOnSurface}"
                   Text="{Binding Snackbar.Text}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
