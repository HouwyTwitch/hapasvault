<Window x:Class="HapasVault.Radial.RadialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:HapasVault.Controls"
        Title="HapasVault — радиальное меню" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.Sans}" Foreground="{DynamicResource OnSurface}" UseLayoutRounding="True">
  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Scrim" Background="{DynamicResource Scrim}" Opacity="0" />

    <c:RadialMenu x:Name="Menu" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

    <!-- разблокировка прямо в оверлее -->
    <Border x:Name="UnlockCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Padding="28,28,28,24" CornerRadius="36"
            Background="{DynamicResource SurfaceContainerHigh}" Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.3" Color="Black" />
      </Border.Effect>
      <StackPanel x:Name="UnlockPanel">
        <c:MorphShape Width="88" Height="88" Shape="Cookie9" TargetShape="Sunny" Spin="10" Fill="{DynamicResource PrimaryContainer}">
          <c:Icon Data="{StaticResource Icon.LockFill}" Width="36" Height="36" Foreground="{DynamicResource OnPrimaryContainer}" />
        </c:MorphShape>
        <TextBlock Style="{StaticResource Headline.Small}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,6" Text="Хранилище закрыто" />
        <TextBlock Style="{StaticResource Body.Medium}" TextAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,20"
                   Text="Введите мастер-пароль, и меню откроется" />
        <c:PasswordField x:Name="Password" Label="Мастер-пароль" />
        <c:WavyProgress x:Name="UnlockProgress" Margin="8,14,8,0" IsIndeterminate="True" Foreground="{DynamicResource Primary}"
                        Track="{DynamicResource SecondaryContainer}" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- загрузка / ошибка -->
    <Border x:Name="StatusCard" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24" CornerRadius="32" MaxWidth="440"
            Background="{DynamicResource SurfaceContainerHigh}" Visibility="Collapsed">
      <StackPanel>
        <c:LoadingIndicator x:Name="StatusSpinner" Width="64" Height="64" Foreground="{DynamicResource Primary}" Container="{DynamicResource PrimaryContainer}" />
        <c:Icon x:Name="StatusIcon" Data="{StaticResource Icon.Warning}" Width="40" Height="40" Foreground="{DynamicResource Error}" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Body.Large}" TextAlignment="Center" Margin="0,16,0,0" />
      </StackPanel>
    </Border>

    <!-- подсказка -->
    <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48" Padding="20,10" CornerRadius="22"
            Background="{DynamicResource InverseSurface}">
      <StackPanel>
        <TextBlock x:Name="TargetText" Style="{StaticResource Label.Large}" TextAlignment="Center" Foreground="{DynamicResource InversePrimary}" />
        <TextBlock Style="{StaticResource Body.Small}" TextAlignment="Center" Margin="0,2,0,0" Foreground="{DynamicResource InverseOnSurface}"
                   Text="ЛКМ — логин и пароль · ПКМ — только пароль · Shift+ЛКМ — только логин · печатайте для поиска · Esc — закрыть" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
