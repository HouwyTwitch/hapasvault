<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Company>hapasvault</Company>
    <Product>HapasVault</Product>
    <!-- каталог сборки CMake с pmapi.dll / pmapi.so и pmtoken_sim -->
    <PmNativeDir Condition="'$(PmNativeDir)' == ''">$(MSBuildThisFileDirectory)..\build\</PmNativeDir>
    <PmNativeDir>$([MSBuild]::EnsureTrailingSlash('$(PmNativeDir)'))</PmNativeDir>
  </PropertyGroup>
</Project>
